# Copy to .env next to docker-compose.yml.
TZ=America/New_York

# Seconds to hold Mode A/C targets back before they appear on the map. 0 for private testing.
PUBLIC_DELAY_S=0

# Where receivers may be (checked against their stated location when they connect):
# us (50 states), ohio (for the Ohio-only test phase), or off.
RECEIVER_AREA=us

# Cloudflare tunnel token (only needed with: docker compose --profile public up -d)
TUNNEL_TOKEN=

# Relay VPS (later): its DNS name and the WireGuard key vps-setup.sh printed. Used with --profile relay.
RELAY_HOST=
RELAY_PUBKEY=
